---
// Portada general del sitio: presenta el taller y lleva a cada eje.
// Cada eje tiene su propia portada (src/pages/hablar/index.astro y src/pages/leer/index.astro).
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/sitio.js';

const ejes = [
  {
    href: ruta('hablar/'),
    logo: ruta('marca/eje04-claro.png'),
    eje: 'Eje 04',
    titulo: 'Hablar',
    bajada: '¿Cómo interactuamos con los modelos de lenguaje?',
    texto:
      'Cómo organizar el trabajo, tipos de tareas, técnicas, armado de prompts, errores frecuentes y dos casos con sus salidas guardadas.',
  },
  {
    href: ruta('leer/'),
    logo: ruta('marca/eje05-portada.png'),
    eje: 'Eje 05',
    titulo: 'Leer',
    bajada: 'Trabajar con papers y fuentes',
    texto:
      'Buscar, verificar y sintetizar bibliografía con IA: cuatro skills para copiar, un cuaderno y las salidas reales de las pruebas.',
  },
];
---

<Base eje="Workshop AcademIA" icono={null}>
  <main>
    <div class="portada-eje">
      <section class="contenedor portada-general">
        <div class="antetitulo-eje">Workshop AcademIA · Proyecto PIDAE 2026-5434</div>
        <h1>LLMs en investigación social</h1>
        <p>
          Material del taller sobre el uso de modelos de lenguaje en la investigación social. Cada eje tiene su guía, sus
          prompts y sus salidas guardadas.
        </p>
        <div class="ejes">
          {
            ejes.map((e) => (
              <a class="eje-tarjeta" href={e.href}>
                <span class="eje-tarjeta-logo"><img src={e.logo} alt="" width="72" height="72" /></span>
                <span class="eje-tarjeta-eje">{e.eje}</span>
                <span class="eje-tarjeta-titulo">{e.titulo}</span>
                <span class="eje-tarjeta-bajada">{e.bajada}</span>
                <span class="eje-tarjeta-texto">{e.texto}</span>
                <span class="eje-tarjeta-entrar">Entrar</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>
