---
import Base from '../layouts/Base.astro';
import Registro from '../components/Registro.astro';
import { listar, leer, csv } from '../lib/archivos.js';
import { sitio, enRepo, rutaSeccion } from '../lib/sitio.js';

const grupos = [
  { carpeta: 'prompts/organizacion/', titulo: 'Organizar el trabajo', seccion: 'organizar-el-trabajo' },
  { carpeta: 'prompts/tecnicas/', titulo: 'Técnicas', seccion: 'tecnicas' },
  { carpeta: 'prompts/componentes/', titulo: 'Componentes del prompt', seccion: 'componentes-del-prompt' },
  { carpeta: 'prompts/caso-1/', titulo: 'Caso 1: análisis de discurso', seccion: 'caso-1' },
  { carpeta: 'prompts/caso-2/', titulo: 'Caso 2: entrevistas y grupo focal', seccion: 'caso-2' },
  { carpeta: 'prompts/ejercicio/', titulo: 'Ejercicio', seccion: 'cierre' },
].map((g) => ({ ...g, archivos: listar(g.carpeta) }));

const salidas = new Set(listar('salidas/'));
const tieneSalida = (archivo) => salidas.has(archivo.replace(/^prompts\//, 'salidas/'));

// Título, fecha y enlace salen del encabezado de cada discurso preparado.
const fuentes = csv(leer('discursos/fuentes.csv') ?? '').filas.map((f) => {
  const archivo = `discursos/${f.nombre}.txt`;
  const texto = leer(archivo) ?? '';
  const dato = (re) => texto.match(re)?.[1]?.trim() ?? '';
  return {
    ...f,
    archivo,
    titulo: dato(/^# (?!Fecha|Fuente|Casa)(.+)$/m),
    fecha: dato(/^# Fecha: (.+)$/m),
    url: dato(/^# Fuente: (.+)$/m),
  };
});
const otros = [
  ...listar('esquemas/').map((a) => [a, 'Esquema de códigos']),
  ...listar('entrevistas/').map((a) => [a, a.endsWith('.csv') ? 'Planilla de fuentes' : 'Corpus FOUBA (CONICET), CC BY-NC-SA 2.5']),
  ...listar('skills/').map((a) => [a, 'Skill del Caso 2']),
  ...listar('plantilla/').map((a) => [a, 'Plantilla de carpeta de proyecto']),
];
const informes = listar('salidas/').filter((a) => /\.(md|csv)$/.test(a));
---

<Base titulo="Materiales" descripcion="Prompts, esquemas, discursos, salidas y registro del taller, como archivos.">
  <div class="contenedor guia">
    <main class="guia-cuerpo">
      <div class="guia-encabezado">
        <div class="antetitulo">Repositorio</div>
        <h1>Materiales</h1>
      </div>

      <div class="prosa">
        <p>
          Cada prompt, esquema y salida del taller es un archivo. El sitio los lee del repositorio, así que hay una sola
          copia de cada uno.
        </p>
        {
          sitio.repo && (
            <p>
              <a class="boton" href={sitio.repo}>
                Abrir el repositorio en GitHub
              </a>
            </p>
          )
        }

        <ul class="indice-interno">
          <li><a href="#prompts">Prompts</a></li>
          <li><a href="#esquemas">Esquemas</a></li>
          <li><a href="#informes">Informes</a></li>
          <li><a href="#fuentes">Fuentes</a></li>
          <li><a href="#registro">Registro de corridas</a></li>
        </ul>

        <h2 id="prompts">Prompts</h2>
        <p>
          Dentro de un archivo de prompt, las líneas que empiezan con <code>#&gt;</code> son anotaciones para el sitio
          y no forman parte del prompt. Las líneas <code>@esquema</code>, <code>@material</code> y <code>@salida</code>{' '}
          se reemplazan por el esquema, el texto o la salida anterior, y <code>@continua</code> indica que el mensaje va
          en la misma conversación que otro prompt. El botón Copiar de cada página entrega el prompt ya armado.
        </p>
        {
          grupos.map((g) => (
            <>
              <h3>
                <a href={rutaSeccion(g.seccion)}>{g.titulo}</a>
              </h3>
              <ul class="lista-materiales">
                {g.archivos.map((a) => (
                  <li>
                    <span class="mono">{enRepo(a) ? <a href={enRepo(a)}>{a}</a> : a}</span>
                    <span>{tieneSalida(a) ? 'Con salida guardada' : 'Sin salida guardada'}</span>
                  </li>
                ))}
              </ul>
            </>
          ))
        }

        <h2 id="esquemas">Esquemas</h2>
        <p>Esquemas de códigos, entrevistas, la skill del Caso 2 y la plantilla de carpeta de proyecto.</p>
        <ul class="lista-materiales">
          {
            otros.map(([a, tipo]) => (
              <li>
                <span class="mono">{enRepo(a) ? <a href={enRepo(a)}>{a}</a> : a}</span>
                <span>{tipo}</span>
              </li>
            ))
          }
        </ul>

        <h2 id="informes">Informes</h2>
        <p>Verificaciones de citas hechas con <code>scripts/verificar_citas.mjs</code> y la planilla que generó la skill.</p>
        <ul class="lista-materiales">
          {
            informes.map((a) => (
              <li>
                <span class="mono">{enRepo(a) ? <a href={enRepo(a)}>{a}</a> : a}</span>
                <span>{a.endsWith('.csv') ? 'Planilla' : 'Verificación de citas'}</span>
              </li>
            ))
          }
        </ul>

        <h2 id="fuentes">Fuentes</h2>
        <p>El material de terceros que usa el sitio, con su licencia.</p>

        <h3>Discursos</h3>
        <p>
          Los discursos salen del sitio de Casa Rosada, que los publica con licencia Creative Commons Reconocimiento 2.5
          Argentina. Los que usa el taller están en <code>discursos/</code> como texto con los párrafos numerados, y cada uno enlaza a su página original.
        </p>
        <ul class="lista-materiales">
          {
            fuentes.map((f) => (
              <li>
                <span>
                  <a href={f.url}>{f.titulo}</a> ({f.fecha})
                </span>
                <span>
                  {f.uso}. <span class="mono">{enRepo(f.archivo) ? <a href={enRepo(f.archivo)}>{f.archivo}</a> : f.archivo}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <h3>Entrevistas y grupo focal</h3>
        <p>Corpus FOUBA de Lourdes Moran (CONICET), bajo licencia{' '} <a href="https://creativecommons.org/licenses/by-nc-sa/2.5/">Creative Commons Atribución-NoComercial-CompartirIgual 2.5</a>.</p>

        <h3>Papers del bloque Leer (Eje 05)</h3>
        <p>
          Los papers no se suben al repositorio: se enlazan a su publicación original. En el sitio se citan solo pasajes
          breves, con su página.
        </p>
        <ul class="lista-materiales">
          <li>
            <span>
              Fontanelli, O., Schulz, M. S., Alba Udave, J., Quintana Nedelcu, D., Tavera Fenollosa, L. y Dussauge Laguna,
              M. I. (2025). Uso y valoración de la inteligencia artificial generativa en los estudios sociales.{' '}
              <em>Perfiles Latinoamericanos</em>, 33(66), 267–279.{' '}
              <a href="https://doi.org/10.18504/pl3366-013-2025">doi.org/10.18504/pl3366-013-2025</a>
            </span>
            <span>Creative Commons Atribución-NoComercial.</span>
          </li>
          <li>
            <span>
              Pérez, J. M., Miguel, P. y Cotik, V. (2025). Exploring Large Language Models for Hate Speech Detection in
              Rioplatense Spanish. <em>Findings of NAACL 2025</em>, 7189–7202.{' '}
              <a href="https://aclanthology.org/2025.findings-naacl.400/">aclanthology.org/2025.findings-naacl.400</a>
            </span>
            <span>Acceso abierto en la ACL Anthology.</span>
          </li>
          <li>
            <span>
              Peters, U. y Chin-Yee, B. (2025). Generalization bias in large language model summarization of scientific
              research. <em>Royal Society Open Science</em>, 12, 241776.{' '}
              <a href="https://doi.org/10.1098/rsos.241776">doi.org/10.1098/rsos.241776</a>
            </span>
            <span>
              <a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Atribución 4.0</a>.
            </span>
          </li>
          <li>
            <span>
              Walters, W. H. y Wilder, E. I. (2023). Fabrication and errors in the bibliographic citations generated by
              ChatGPT. <em>Scientific Reports</em>, 13, 14045.{' '}
              <a href="https://doi.org/10.1038/s41598-023-41032-5">doi.org/10.1038/s41598-023-41032-5</a>
            </span>
            <span>
              <a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Atribución 4.0</a>.
            </span>
          </li>
        </ul>

        <h2 id="registro">Registro de corridas</h2>
        <p>Cada salida guardada tiene su fila, con herramienta, modelo, nivel de esfuerzo y fecha.</p>
        <Registro />
      </div>
    </main>
  </div>
</Base>
