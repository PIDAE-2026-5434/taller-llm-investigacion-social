---
// Portada del bloque Leer (Eje 05), con la misma estructura que la portada del Eje 04:
// banda de color con el título y la lista de secciones (src/lib/leer.js).
import Base from '../../layouts/Base.astro';
import { ruta } from '../../lib/sitio.js';
import { seccionesLeer, rutaLeer, eje, icono } from '../../lib/leer.js';
---

<Base titulo="Leer" descripcion="Leer con IA: cuatro skills y un cuaderno para buscar, verificar y sintetizar papers y fuentes, con sus instrucciones y salidas reales." eje={eje} icono={icono}>
  <main>
    <div class="portada-eje">
      <section class="contenedor portada">
        <div class="portada-texto">
          <img class="portada-logo" src={ruta('marca/eje05-portada.png')} alt="" width="110" height="110" />
          <div class="antetitulo-eje">Eje 05 · Workshop AcademIA</div>
          <h1>Leer</h1>
          <h2 class="portada-bajada">Trabajar con papers y fuentes</h2>
          <p>
            La IA puede leer y muy rápido. La comprensión queda de nuestro lado. Este bloque recorre los tres pasos del
            trabajo con bibliografía: buscar, verificar lo que se encontró y sintetizar sin perder el alcance de los
            textos. Trae cuatro skills con sus instrucciones para copiar, y las salidas reales de las pruebas que hicimos
            con Gemini, Gemini Notebook y la cuenta de la facultad.
          </p>
          <div class="portada-botones">
            <a class="boton" href={rutaLeer('skills')}>Empezar</a>
            <a class="boton boton-linea" href={rutaLeer('skills') + '#skills'}>Ver las cuatro skills</a>
          </div>
        </div>

        <figure class="ejemplo-marcado">
          <figcaption>Pérez, Miguel y Cotik (2025), p. 7194, y la ficha de lectura que armó una IA con ese paper.</figcaption>
          <blockquote>
            "They stay equal or get better when regionalisms are present in the text. This{' '}
            <span class="marca">might be due</span> to the fact that regionalisms are likely to be matched with slang
            slurs."
          </blockquote>
          <dl class="ejemplo-codigos">
            <dt><span class="marca">El paper</span></dt>
            <dd>«might be due»: una hipótesis</dd>
            <dt><span class="subrayado">La IA</span></dt>
            <dd>«dado que»: una certeza</dd>
          </dl>
        </figure>
      </section>
    </div>

    <section class="contenedor bloque-secciones" id="secciones">
      <div class="bloque-secciones-titulo">
        <h2>Seis secciones</h2>
        <p>Se pueden leer en orden o entrar por un paso.</p>
      </div>
      <ol class="lista-secciones">
        {
          seccionesLeer.map((s) => (
            <li>
              <a href={rutaLeer(s.slug)}>
                <span class="lista-n">{s.n}</span>
                <span class="lista-titulo">{s.titulo}</span>
                <span class="lista-bajada">{s.bajada}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  .portada-bajada {
    font-weight: 700;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.15;
    margin-top: -12px;
  }
</style>
