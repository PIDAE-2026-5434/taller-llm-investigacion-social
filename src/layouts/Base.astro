---
import '@fontsource/zilla-slab/700.css';
import '@fontsource-variable/dm-sans/index.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { sitio, ruta, rutaSeccion } from '../lib/sitio.js';

// eje e icono: el rótulo y el símbolo de la cabecera. Por defecto, los del Eje 04; Leer pasa los suyos.
const { titulo, descripcion = sitio.descripcion, eje = null, icono = 'marca/eje04.png' } = Astro.props;
const rotuloEje = eje ?? 'Eje 04 · Cómo interactuamos con los modelos de lenguaje';
const tituloPagina = titulo ? `${titulo} · ${sitio.titulo}` : `${sitio.titulo} · ${sitio.proyecto}`;

const camino = Astro.url.pathname;
const en = (parte) => camino.includes(parte);
const menu = [
  { texto: 'HABLAR', href: rutaSeccion('organizar-el-trabajo'), actual: en('/guia/') && !en('/guia/caso-') },
  { texto: 'Caso 1', href: rutaSeccion('caso-1'), actual: en('/guia/caso-1/') },
  { texto: 'Caso 2', href: rutaSeccion('caso-2'), actual: en('/guia/caso-2/') },
  { texto: 'LEER', href: ruta('leer/'), actual: en('/leer/') },
  { texto: 'Materiales', href: ruta('materiales/'), actual: en('/materiales/') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={ruta('favicon.svg')} />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor">
        <a class="cabecera-marca" href={ruta('')}>
          <img class="academia" src={ruta('marca/academia.png')} alt="AcademIA" width="140" height="22" />
          <span class="cabecera-eje">
            <img src={ruta(icono)} alt="" width="16" height="16" />
            <span>{rotuloEje}</span>
          </span>
        </a>
        <nav aria-label="Principal">
          {
            menu.map((m) => (
              <a href={m.href} aria-current={m.actual ? 'page' : undefined}>
                {m.texto}
              </a>
            ))
          }
          {sitio.repo && <a href={sitio.repo}>GitHub</a>}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="pie">
      <div class="contenedor">
        <div class="pie-logos">
          <img class="uba" src={ruta('marca/uba-sociales.png')} alt="UBA Sociales, Facultad de Ciencias Sociales" width="190" height="30" />
          <img class="sello" src={ruta('marca/sello-uba.png')} alt="Sello de la Universidad de Buenos Aires" width="38" height="38" />
        </div>
        <p>{sitio.institucion}</p>
        <p>
          Discursos: Casa Rosada, bajo licencia{' '}
          <a href="https://creativecommons.org/licenses/by/2.5/ar/">Creative Commons Reconocimiento 2.5 Argentina</a>.
        </p>
        <p>
          Entrevistas y grupo focal: corpus FOUBA de Lourdes Moran (CONICET), bajo licencia{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/2.5/">Creative Commons Atribución-NoComercial-CompartirIgual 2.5</a>.
        </p>
      </div>
    </footer>

    <script>
      // Pestañas Prompt / Salida y botón de copiar de cada bloque.
      document.querySelectorAll<HTMLElement>('[data-bloque]').forEach((bloque) => {
        const pestanas = bloque.querySelectorAll<HTMLButtonElement>('[data-ver]');
        const paneles = bloque.querySelectorAll<HTMLElement>('[data-panel]');

        pestanas.forEach((pestana) => {
          pestana.addEventListener('click', () => {
            pestanas.forEach((p) => p.setAttribute('aria-pressed', String(p === pestana)));
            paneles.forEach((panel) => {
              panel.hidden = panel.dataset.panel !== pestana.dataset.ver;
            });
          });
        });

        const copiar = bloque.querySelector<HTMLButtonElement>('[data-copiar]');
        copiar?.addEventListener('click', async () => {
          const visible = [...paneles].find((p) => !p.hidden) ?? paneles[0];
          const texto = visible?.querySelector('[data-texto]')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(texto);
            copiar.textContent = 'Copiado';
          } catch {
            copiar.textContent = 'No se pudo copiar';
          }
          setTimeout(() => {
            copiar.textContent = 'Copiar';
          }, 1800);
        });
      });
    </script>
  </body>
</html>
